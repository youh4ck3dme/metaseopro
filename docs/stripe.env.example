# Add only the required Stripe keys to ignored .env.local / the correct server secret store.
# Review existing values first; never paste this whole template over deployed configuration.
# Blank values are deliberate. Never commit real secrets or add a VITE_ prefix.
SITE_URL="https://seo4web.lovable.app"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_AGENCY_MONTHLY=""
# Live checkout requires true AFTER seller/registrations/product tax review.
STRIPE_AUTOMATIC_TAX_ENABLED="false"

# Lovable manages reserved SUPABASE_* bindings. Preserve them; do not add blank
# overrides or request the service-role key / database password from the owner.
# Verify that the existing server integration can call the service-role-only
# billing RPCs in the correct project. A public/anon client cannot replace it.
# Outside Lovable, use that environment's authorized server provisioning process.

# Not connected to webhook. Keep disabled until accounting outbox/reconciliation exists.
SUPERFAKTURA_INVOICING_ENABLED="false"
SUPERFAKTURA_EMAIL_ENABLED="false"
SUPERFAKTURA_EMAIL=""
SUPERFAKTURA_API_KEY=""
SUPERFAKTURA_COMPANY_ID=""
SUPERFAKTURA_MODULE="SEO4WEB"
SUPERFAKTURA_API_URL=""
