# ==============================================================================
# SEO4WEB — Environment Configuration Template (.env.example)
# ==============================================================================
#
# PRAVIDLÁ PRE PREMENNÉ PROSTREDIA:
# 1. Súbor .env obsahuje LEN verejné hodnoty potrebné pre beh frontendu a SSR.
# 2. Lokálne tajné kľúče (ak vyvíjaš offline) vkladaj výhradne do súboru .env.local!
# 3. .env.local je striktne v .gitignore a nikdy sa nesmie dostať do Git repozitára.
# 4. Produkčné tajné kľúče sú spravované priamo v Lovable Cloud Secrets a Cloudflare.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VEREJNÉ PREMENNÉ PRE FRONTEND & SSR (Supabase Lovable Cloud)
# Tieto premenné sú bezpečné na expozíciu v klientskom kóde.
# ------------------------------------------------------------------------------
VITE_SUPABASE_PROJECT_ID=pwftbssvdbjoblmhdeax
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HXyJkq0uW4KXylZnSwiAjg_k4dFbYYS
VITE_SUPABASE_URL=https://pwftbssvdbjoblmhdeax.supabase.co

# SSR Fallback (pre node/workerd prostredie na serveri)
SUPABASE_PROJECT_ID=pwftbssvdbjoblmhdeax
SUPABASE_PUBLISHABLE_KEY=sb_publishable_HXyJkq0uW4KXylZnSwiAjg_k4dFbYYS
SUPABASE_URL=https://pwftbssvdbjoblmhdeax.supabase.co

# ------------------------------------------------------------------------------
# 2. TAJNÉ KĽÚČE PRE SERVER & CLOUD (NEVKLADAŤ DO .env ANI DO GITU!)
# Nastavujú sa v Lovable Cloud Secrets / Cloudflare Workers environment variables.
# Pre lokálny vývoj ich môžeš definovať v .env.local.
# ------------------------------------------------------------------------------

# Supabase Service Role Key (pre admin serverové operácie s bypassom RLS)
# SUPABASE_SERVICE_ROLE_KEY=eyJh...

# Lovable AI Gateway API kľúč (pre volanie AI modelov pri generovaní obsahu, briefov a analýz)
# LOVABLE_API_KEY=lov_live_...

# Semrush API kľúč (pre živý SEO audit domén a analýzu konkurencie)
# SEMRUSH_API_KEY=...

# Google Search Console API kľúč (pre Lovable Search Console connector a živé dáta)
# GOOGLE_SEARCH_CONSOLE_API_KEY=...

# Lovable Database Direct Migration URL (používané v drizzle.config.ts)
# LOVABLE_DB_MIGRATION_URL=postgresql://postgres:...@...supabase.co:5432/postgres
