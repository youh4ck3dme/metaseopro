# Environment files & Local Secrets
# NOTE: .env IS committed, but with PUBLIC values only (Lovable reads VITE_* from it).
# .env.* variants stay ignored (except .env.example). Never commit private keys!
# Use .env.local / platform secrets for local overrides.
.env.*
!.env.example
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
*.local

# Wrangler / Cloudflare Workers
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

